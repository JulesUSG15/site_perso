{
  "name": "site-perso",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "docker:dev": "docker compose up",
    "docker:dev:down": "docker compose down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:pub:up": "docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml up -d",
    "docker:pub:down": "docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml down",
    "docker:pub:logs": "docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml logs -f",
    "docker:rebuild": "docker compose -f docker-compose.prod.yml build --no-cache"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "nodemailer": "6.10.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
