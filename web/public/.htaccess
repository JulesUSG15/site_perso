DirectoryIndex index.html
ErrorDocument 404 /404.html

# mod_rewrite is already enabled on cerbere; no proxy or headers modules.
RewriteEngine On
# THE_REQUEST avoids redirecting Apache's internal DirectoryIndex request.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(2048|Bdanse|Compil|Dac|GTSRB|Info|IsiWeb|MNIST|MisoMania|PersoWeb|Polycars|Processor|Snake|Sudoku|Vin|about)\.html$ / [R=301,L]

# Next exports generated metadata images without a file extension.
<FilesMatch "^(icon|apple-icon|opengraph-image|twitter-image)$">
  ForceType image/png
</FilesMatch>
