########################################
# VARIABLES DE BUILD (baked)
# — utilisées au moment de `next build`
# — préfixe NEXT_PUBLIC_ ⇒ intégrées au bundle client, donc PUBLIQUES
# — NE JAMAIS y mettre de secret
########################################

# URL publique du site. Sert au SEO (canonical, OG, sitemap) et à
# metadataBase. Reconstruire l'image si on la change.
NEXT_PUBLIC_SITE_URL=https://jules.ginhac.com


########################################
# VARIABLES RUNTIME
# — lues au démarrage du conteneur (jamais dans le bundle client)
# — passer par un fichier .env local, jamais commit
########################################

# Adresse à afficher dans la section contact et vers laquelle sont envoyés
# les messages du formulaire. Doit être une adresse réelle et surveillée.
CONTACT_EMAIL=

# Envoi SMTP. Si l'une de ces variables est absente, le site n'affichera
# JAMAIS un faux succès : le formulaire indique clairement une erreur et
# propose un contact direct par email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


########################################
# VARIABLES POUR LE REVERSE PROXY (production publique)
# — utilisées uniquement par docker-compose.caddy.yml
########################################

# Domaine que Caddy va servir. Le DNS A/AAAA doit déjà pointer vers le VPS.
DOMAIN=

# Email transmis à Let's Encrypt pour les certificats (récupération de compte).
ACME_EMAIL=


########################################
# DIVERS
########################################

# Tag Docker de l'image applicative (pour rollback). Défaut : latest.
# Exemple : TAG=2026-09-30-01
TAG=latest
