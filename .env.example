# URL publique du site (utilisée pour SEO, sitemap, canonicals, Open Graph).
NEXT_PUBLIC_SITE_URL=https://jules.ginhac.com

# Adresse à afficher dans la section contact et vers laquelle sont envoyés
# les messages du formulaire. Doit être une adresse réelle et surveillée.
CONTACT_EMAIL=

# Envoi d'email SMTP (optionnel). Si l'une de ces variables est absente,
# le site n'affichera JAMAIS un faux succès : le formulaire indiquera
# clairement une erreur et proposera un contact direct par email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
